#!/usr/bin/env bash

export CHECKUPDATES_DB="/tmp/checkup-db-${UID}-$$"
trap 'rm -rf -- "$CHECKUPDATES_DB"' EXIT

mapfile -t updates < <(checkupdates --nocolor 2>/tmp/checkupdates-error)

if (( ${#updates[@]} == 0 )); then
    error=$(< /tmp/checkupdates-error)

    if [[ -n "$error" ]]; then
        jq -cn --arg error "$error" '{
            text: "?",
            tooltip: $error
        }'
    else
        jq -cn '{
            text: "0x",
            tooltip: "<span weight=\"bold\">No updates!</span>"
        }'
    fi

    exit 0
fi

tooltip=""

for update in "${updates[@]}"; do
    read -r package old_version _ new_version <<< "$update"

    tooltip+="<span weight=\"bold\">${package}</span>"
    tooltip+=" <span weight=\"bold\" foreground=\"red\">${old_version}</span>"
    tooltip+=" → "
    tooltip+="<span weight=\"bold\" foreground=\"green\">${new_version}</span>"
    tooltip+=$'\n'
done

count=${#updates[@]}

jq -cn \
    --arg text "${count}x" \
    --arg tooltip "$tooltip" \
    '{text: $text, tooltip: $tooltip}'
